# Marathon coding session logs (regenerated each run)
.marathon/logs/
.marathon/artifacts/

# Beads — issue tracker database and state
# Bead store: SQLite and history stay local; the JSONL checkpoint is tracked.
# Must be `.beads/*`, not `.beads/` — git cannot re-include a file whose
# parent directory is excluded.
# bead-rs: the checkpoint under .beads/ is the durable store and IS tracked.
# .beads/.gitignore excludes the SQLite db and scratch files.
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal
!.beads/issues.jsonl

# Needle dispatch state
.needle-predispatch-sha

# Node / pnpm (Phase 1+)
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo

# Rust (Phase 2+)
target/
Cargo.lock.bak

# Python
__pycache__/
*.pyc

# Playwright
playwright-report/
test-results/

# Phone-smoke artifacts (regenerated each run; baselines are committed)
e2e/phone-smoke/artifacts/

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*~
